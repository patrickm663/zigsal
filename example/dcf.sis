define Main 

type RealVector = array [double_real];
type RealMatrix = array [RealVector];

% Pure dot product: The core of the DCF calculation
function dot_product(v1: RealVector; v2: RealVector returns double_real)
   for i in 1, array_size(v1)
      p := v1[i] * v2[i]
   returns value of sum p
   end for
end function

function Main(num_policies: integer; num_months: integer returns RealVector)
   let
      % 1. Generate the Discount Factor vector
      % NOW DEPENDENT ON INDEX 'i' TO DEFEAT CONSTANT FOLDING
      df_vector := for i in 1, num_months 
                   returns array of double_real(i) * 0.005d0 
                   end for;

      % 2. Process 1 Million Policies
      results := 
         for r in 1, num_policies
            % Generate Cash Flow data for this row
            % NOW DEPENDENT ON ROW 'r' AND COL 'c'
            cf_row := for c in 1, num_months 
                      returns array of (double_real(r)) + (double_real(c)) 
                      end for;
         returns array of dot_product(cf_row, df_vector)
         end for;
   in
      results
   end let
end function
